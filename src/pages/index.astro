---
import Base from "../layouts/Base.astro";
import "../styles/global.css";
import { getToken } from "../lib/auth";
const loggedIn = Boolean(getToken(Astro.cookies));
---
<Base>
  <div class="min-h-screen grid grid-rows-[3.25rem_1fr_auto]">
    <header class="sticky top-0 z-20 flex items-center gap-3 px-4 sm:px-6 border-b border-white/10 bg-card/80 backdrop-blur-md">
      <a href="/" class="inline-flex items-center gap-2 font-bold text-fg no-underline">
        <img src="/mark.svg" alt="" width="22" height="22" />
        Status<span class="text-brand">Grep</span>
      </a>
      <div class="flex-1"></div>
      {loggedIn ? (
        <>
          <a class="sg-btn text-xs py-1.5" href="/projects">Dashboard</a>
          <a class="sg-btn-ghost text-xs py-1.5" href="/logout">Sign out</a>
        </>
      ) : (
        <>
          <a class="sg-btn-ghost text-xs py-1.5" href="/login">Log in</a>
          <a class="sg-btn text-xs py-1.5" href="/register">Sign up</a>
        </>
      )}
    </header>

    <main class="px-4 sm:px-6 py-16 sm:py-24 max-w-3xl mx-auto w-full animate-fadeUp">
      <p class="text-muted text-xs uppercase tracking-widest mb-4">HTTP monitoring</p>
      <h1 class="text-4xl sm:text-5xl font-bold leading-tight mb-4">
        Status<span class="bg-gradient-to-r from-brand to-brand2 bg-clip-text text-transparent">Grep</span>
      </h1>
      <p class="text-muted text-base leading-relaxed max-w-xl mb-10">
        Check endpoints on a schedule. See Operational, Degraded, or Outage.
        Open incidents, alert the team, publish a public status page.
      </p>
      <div class="grid sm:grid-cols-3 gap-3 mb-12">
        <div class="sg-card">
          <div class="text-brand text-xs font-bold mb-1">Checks</div>
          <p class="text-muted text-xs m-0 leading-relaxed">Scheduled HTTP probes with thresholds and history.</p>
        </div>
        <div class="sg-card">
          <div class="text-brand2 text-xs font-bold mb-1">Incidents</div>
          <p class="text-muted text-xs m-0 leading-relaxed">Auto-open on outage; acknowledge and post updates.</p>
        </div>
        <div class="sg-card">
          <div class="text-brand text-xs font-bold mb-1">Public</div>
          <p class="text-muted text-xs m-0 leading-relaxed">Share status for services you mark public.</p>
        </div>
      </div>
      {!loggedIn && (
        <div class="flex flex-wrap gap-3">
          <a class="sg-btn" href="/register">Get started</a>
          <a class="sg-btn-ghost" href="/login">I have an account</a>
        </div>
      )}
      {loggedIn && (
        <a class="sg-btn" href="/projects">Open dashboard</a>
      )}
    </main>

    <footer class="border-t border-white/10 px-4 py-3 text-xs text-muted flex flex-wrap items-center justify-between gap-2">
      <span>© {new Date().getFullYear()} StatusGrep · Status Pulse</span>
      <span class="inline-flex items-center gap-2" id="api-health">
        <span class="w-1.5 h-1.5 rounded-full bg-unknown" id="api-health-dot"></span>
        <span id="api-health-label">API …</span>
      </span>
    </footer>
  </div>
  <script>
    async function ping() {
      const dot = document.getElementById("api-health-dot");
      const label = document.getElementById("api-health-label");
      try {
        const r = await fetch("/api/health");
        const j = await r.json();
        if (dot) dot.className = "w-1.5 h-1.5 rounded-full " + (j.ok ? "bg-ok" : "bg-bad");
        if (label) label.textContent = j.ok ? "API ok" : "API down";
      } catch {
        if (dot) dot.className = "w-1.5 h-1.5 rounded-full bg-bad";
        if (label) label.textContent = "API unreachable";
      }
    }
    ping();
    setInterval(ping, 30000);
  </script>
</Base>
