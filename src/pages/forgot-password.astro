---
import Base from "../layouts/Base.astro";
import "../styles/global.css";
import Flash from "../components/Flash.astro";
import { api } from "../lib/api";
let ok: string | null = null;
let error: string | null = null;
if (Astro.request.method === "POST") {
  try {
    const f = await Astro.request.formData();
    await api("/api/v1/auth/forgot-password", {
      method: "POST",
      body: { email: String(f.get("email")) },
    });
    ok = "If that email exists, a reset token was sent.";
  } catch (e) {
    error = e instanceof Error ? e.message : "Failed";
  }
}
---
<Base title="Forgot password">
  <main class="min-h-screen flex items-center justify-center px-4">
    <form method="post" class="sg-card w-full max-w-sm flex flex-col gap-3">
      <h1 class="text-lg font-semibold m-0">Forgot password</h1>
      <Flash error={error} ok={ok} />
      <input class="sg-input" type="email" name="email" required placeholder="Email" />
      <button class="sg-btn" type="submit">Send reset token</button>
      <a href="/login" class="text-muted text-xs">Back</a>
    </form>
  </main>
</Base>
