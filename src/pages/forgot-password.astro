---
import Base from "../layouts/Base.astro";
import "../styles/global.css";
import Flash from "../components/Flash.astro";
import { api } from "../lib/api";
let ok: string | null = null;
let error: string | null = null;
if (Astro.request.method === "POST") {
  try {
    const f = await Astro.request.formData();
    await api("/api/v1/auth/forgot-password", {
      method: "POST",
      body: { email: String(f.get("email")) },
    });
    ok = "If that email exists, a reset link was sent. Check your inbox.";
  } catch (e) {
    error = e instanceof Error ? e.message : "Failed";
  }
}
---
<Base title="Forgot password">
  <main class="min-h-screen flex items-center justify-center px-4">
    <form method="post" class="sg-card w-full max-w-sm flex flex-col gap-3 animate-fadeUp">
      <h1 class="text-lg font-semibold m-0">Forgot password</h1>
      <p class="text-muted text-xs m-0">We’ll email a link to set a new password. The link expires in one hour.</p>
      <Flash error={error} ok={ok} />
      <label class="sg-label">Email
        <input class="sg-input" type="email" name="email" required autocomplete="email" />
      </label>
      <button class="sg-btn" type="submit">Send reset link</button>
      <p class="text-muted text-xs m-0 flex flex-wrap gap-x-2">
        <a href="/reset-password">I already have a token</a>
        <span>·</span>
        <a href="/login">Back to login</a>
      </p>
    </form>
  </main>
</Base>
