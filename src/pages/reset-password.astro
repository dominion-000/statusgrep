---
import Base from "../layouts/Base.astro";
import "../styles/global.css";
import Flash from "../components/Flash.astro";
import { api } from "../lib/api";
let ok: string | null = null;
let error: string | null = null;
if (Astro.request.method === "POST") {
  try {
    const f = await Astro.request.formData();
    await api("/api/v1/auth/reset-password", {
      method: "POST",
      body: { token: String(f.get("token")), password: String(f.get("password")) },
    });
    ok = "Password updated. You can log in.";
  } catch (e) {
    error = e instanceof Error ? e.message : "Failed";
  }
}
---
<Base title="Reset password">
  <main class="min-h-screen flex items-center justify-center px-4">
    <form method="post" class="sg-card w-full max-w-sm flex flex-col gap-3">
      <h1 class="text-lg font-semibold m-0">Reset password</h1>
      <Flash error={error} ok={ok} />
      <input class="sg-input" name="token" required placeholder="Token from email" />
      <input class="sg-input" type="password" name="password" required minlength="12" placeholder="New password" />
      <button class="sg-btn" type="submit">Update</button>
      <a href="/login" class="text-muted text-xs">Log in</a>
    </form>
  </main>
</Base>
