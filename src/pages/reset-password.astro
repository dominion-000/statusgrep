---
import Base from "../layouts/Base.astro";
import "../styles/global.css";
import Flash from "../components/Flash.astro";
import { api } from "../lib/api";

const tokenFromQuery = Astro.url.searchParams.get("token") || "";
let ok: string | null = null;
let error: string | null = null;

if (Astro.request.method === "POST") {
  try {
    const f = await Astro.request.formData();
    await api("/api/v1/auth/reset-password", {
      method: "POST",
      body: {
        token: String(f.get("token") || ""),
        password: String(f.get("password") || ""),
      },
    });
    ok = "Password updated. You can log in.";
  } catch (e) {
    error = e instanceof Error ? e.message : "Reset failed";
  }
}
---
<Base title="Reset password">
  <main class="min-h-screen flex items-center justify-center px-4">
    <form method="post" class="sg-card w-full max-w-sm flex flex-col gap-3 animate-fadeUp">
      <h1 class="text-lg font-semibold m-0">Reset password</h1>
      <p class="text-muted text-xs m-0">
        Use the link from your email, or paste the token if you have one.
      </p>
      <Flash error={error} ok={ok} />
      <label class="sg-label">Token
        <input
          class="sg-input"
          name="token"
          required
          value={tokenFromQuery}
          placeholder="From email"
          autocomplete="off"
        />
      </label>
      <label class="sg-label">New password (min 12)
        <input class="sg-input" type="password" name="password" required minlength="12" autocomplete="new-password" />
      </label>
      <button class="sg-btn" type="submit">Update password</button>
      {ok ? (
        <a href="/login" class="sg-btn-ghost text-center text-xs">Go to login</a>
      ) : (
        <a href="/login" class="text-muted text-xs">Back to login</a>
      )}
    </form>
  </main>
</Base>
