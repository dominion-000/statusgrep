<h1>Log in</h1>
<% if (typeof error !== "undefined" && error) { %><div class="flash flash-error"><%= error %></div><% } %>
<form method="post" action="/login" class="stack card">
  <label class="field">Email <input type="email" name="email" required value="<%= email || "" %>" /></label>
  <label class="field">Password <input type="password" name="password" required /></label>
  <button class="btn" type="submit">Log in</button>
</form>
<p class="muted">No account? <a href="/register">Register</a></p>
