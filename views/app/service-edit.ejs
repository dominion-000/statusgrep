<p class="muted"><a href="/projects/<%= projectId %>/services/<%= service.id %>">← Service</a></p>
<h1>Edit service</h1>
<% if (typeof error !== "undefined" && error) { %><div class="flash flash-error"><%= error %></div><% } %>
<form method="post" action="/projects/<%= projectId %>/services/<%= service.id %>/edit" class="card stack">
  <label class="field">Name <input name="name" required value="<%= service.name %>" /></label>
  <label class="field">URL <input name="url" required value="<%= service.url %>" /></label>
  <label class="field">Method
    <select name="method">
      <% ["GET","HEAD","POST"].forEach(function (m) { %>
        <option value="<%= m %>" <%= service.method === m ? "selected" : "" %>><%= m %></option>
      <% }) %>
    </select>
  </label>
  <label class="field">Interval (s) <input name="intervalSeconds" type="number" value="<%= service.intervalSeconds %>" /></label>
  <label class="field">Timeout (s) <input name="timeoutSeconds" type="number" value="<%= service.timeoutSeconds %>" /></label>
  <label class="field">Expected status codes (comma)
    <input name="expectedStatusCodes" value="<%= (service.expectedStatusCodes || [200]).join ? (service.expectedStatusCodes || [200]).join(',') : '200' %>" />
  </label>
  <label class="field"><input type="checkbox" name="isPublic" value="true" <%= service.isPublic ? "checked" : "" %> /> Public on status page</label>
  <button class="btn" type="submit">Save</button>
</form>
