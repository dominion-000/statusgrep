<p class="muted"><a href="/projects/<%= projectId %>/incidents">← Incidents</a></p>
<h1><%= incident.title %></h1>
<p>
  <span class="status-pill"><%= incident.status %></span>
  <% if (incident.resolvedAt) { %><span class="muted">Resolved <%= new Date(incident.resolvedAt).toLocaleString("en-GB", { timeZone: "Africa/Lagos", dateStyle: "medium", timeStyle: "short" }) %></span><% } %>
</p>
<% if (typeof error !== "undefined" && error) { %><div class="flash flash-error"><%= error %></div><% } %>
<section class="card" style="margin-top:1rem">
  <h2>Timeline</h2>
  <% if (!updates || !updates.length) { %><p class="muted">No updates yet.</p><% } else { %>
    <ul class="stack">
      <% updates.forEach(function (u) { %>
        <li>
          <strong><%= u.status || "Note" %></strong>
          <span class="muted"><%= u.createdAt ? new Date(u.createdAt).toLocaleString("en-GB", { timeZone: "Africa/Lagos", dateStyle: "medium", timeStyle: "short" }) : "" %></span>
          <div><%= u.message %></div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>
<% if (!incident.resolvedAt) { %>
<form method="post" action="/projects/<%= projectId %>/incidents/<%= incident.id %>/updates" class="card stack" style="margin-top:1rem">
  <h2>Post update</h2>
  <label class="field">Message <textarea name="message" rows="3"></textarea></label>
  <label class="field">Status (optional)
    <select name="status">
      <option value="">— note only —</option>
      <option>Investigating</option>
      <option>Identified</option>
      <option>Monitoring</option>
      <option>Resolved</option>
    </select>
  </label>
  <label class="field"><input type="checkbox" name="isPublic" value="true" /> Public</label>
  <button class="btn" type="submit">Post</button>
</form>
<% } %>
