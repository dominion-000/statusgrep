<div class="row">
  <div>
    <h1 style="margin-bottom:0.15rem"><%= project.name %></h1>
    <p class="muted" style="margin:0"><%= project.slug %></p>
  </div>
  <div class="row" style="gap:0.5rem">
    <a class="btn secondary" href="/status/<%= project.slug %>" target="_blank" rel="noopener">Public status ↗</a>
    <form method="post" action="/projects/<%= project.id %>/delete" style="display:inline" onsubmit="return confirm('Delete this project and all its services?');">
      <button class="btn danger" type="submit">Delete project</button>
    </form>
  </div>
</div>
<% if (typeof error !== "undefined" && error) { %><div class="flash flash-error"><%= error %></div><% } %>

<section class="card" style="margin-top:1rem">
  <div class="row">
    <h2 style="margin:0">Services</h2>
    <span class="muted"><%= services.length %> total</span>
  </div>
  <% if (!services.length) { %>
    <div class="empty" style="margin-top:0.75rem">No services — add one below.</div>
  <% } else { %>
    <table class="data" style="margin-top:0.5rem">
      <thead>
        <tr><th>Name</th><th>Status</th><th>Endpoint</th><th>Check</th><th></th></tr>
      </thead>
      <tbody>
        <% services.forEach(function (s) { %>
          <tr>
            <td><a href="/projects/<%= project.id %>/services/<%= s.id %>"><%= s.name %></a></td>
            <td><span class="status-pill" data-status="<%= s.status || 'Unknown' %>"><%= s.status || 'Unknown' %></span></td>
            <td class="muted" style="max-width:14rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= s.url %></td>
            <td class="muted"><%= s.intervalSeconds %>s · <%= s.enabled === false ? "off" : "on" %></td>
            <td><a href="/projects/<%= project.id %>/services/<%= s.id %>/edit">Edit</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</section>

<form method="post" action="/projects/<%= project.id %>/services" class="card stack" style="margin-top:1rem">
  <h2>Add service</h2>
  <div class="panel-grid cols-2">
    <label class="field">Name <input name="name" required /></label>
    <label class="field">URL <input name="url" type="url" required placeholder="https://" /></label>
    <label class="field">Method
      <select name="method">
        <option value="GET" selected>GET</option>
        <option value="HEAD">HEAD</option>
        <option value="POST">POST</option>
      </select>
    </label>
    <label class="field">Interval
      <select name="intervalSeconds">
        <option value="30">30s</option>
        <option value="60" selected>60s</option>
        <option value="120">2 min</option>
        <option value="300">5 min</option>
        <option value="600">10 min</option>
        <option value="900">15 min</option>
        <option value="1800">30 min</option>
        <option value="3600">1 hour</option>
      </select>
    </label>
    <label class="field">Timeout (s) <input name="timeoutSeconds" type="number" value="10" min="1" max="120" /></label>
    <label class="field">Expected status codes
      <input name="expectedStatusCodes" value="200" placeholder="200 or 200,201" />
    </label>
  </div>
  <label class="field" style="flex-direction:row;align-items:center;gap:0.5rem">
    <input type="checkbox" name="isPublic" value="true" />
    <span>Public on status page</span>
  </label>
  <button class="btn" type="submit">Create service</button>
</form>
