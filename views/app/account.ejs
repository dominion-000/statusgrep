<h1>Account</h1>
<% if (typeof message !== "undefined" && message) { %><div class="flash flash-ok"><%= message %></div><% } %>
<% if (typeof error !== "undefined" && error) { %><div class="flash flash-error"><%= error %></div><% } %>
<form method="post" action="/account" class="card stack" style="max-width:28rem">
  <label class="field">Name
    <input name="name" value="<%= account.name || "" %>" maxlength="120" autocomplete="name" placeholder="Display name" />
  </label>
  <label class="field">Email
    <input type="email" name="email" value="<%= account.email %>" required autocomplete="email" />
  </label>
  <hr style="border:none;border-top:1px solid var(--border);margin:0.5rem 0" />
  <p class="muted" style="margin:0">Change password (leave blank to keep current)</p>
  <label class="field">Current password
    <input type="password" name="currentPassword" autocomplete="current-password" />
  </label>
  <label class="field">New password
    <input type="password" name="newPassword" minlength="12" autocomplete="new-password" placeholder="At least 12 characters" />
  </label>
  <button class="btn" type="submit">Save</button>
</form>
