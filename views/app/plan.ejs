<p class="muted"><a href="/projects/<%= projectId %>">← Project</a></p>
<h1>Plan</h1>
<% if (typeof message !== "undefined" && message) { %><div class="flash flash-ok"><%= message %></div><% } %>
<% if (typeof error !== "undefined" && error) { %><div class="flash flash-error"><%= error %></div><% } %>
<div class="card">
  <p>Current: <strong><%= planName %></strong></p>
  <p class="muted">Services <%= usage.services %> / <%= limits.services %> · Members <%= usage.members %> / <%= limits.members %></p>
</div>
<% if (planName === "free") { %>
  <form method="post" action="/projects/<%= projectId %>/plans" class="card stack" style="margin-top:1rem">
    <input type="hidden" name="planName" value="pro" />
    <button class="btn" type="submit">Upgrade to pro</button>
  </form>
<% } %>
