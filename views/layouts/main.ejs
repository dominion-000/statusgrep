<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= typeof title !== "undefined" ? title + " · " : "" %>StatusGrep</title>
    <link rel="stylesheet" href="/assets/styles.css" />
  </head>
  <body>
    <div class="app-shell">
      <header class="app-header">
        <a class="brand" href="<%= typeof brandHref !== "undefined" ? brandHref : "/" %>">Status<span>Grep</span></a>
        <% if (typeof nav !== "undefined" && nav && nav.length) { %>
          <nav>
            <% nav.forEach(function (item) { %>
              <a href="<%= item.href %>" class="<%= item.active ? "active" : "" %>"><%= item.label %></a>
            <% }) %>
          </nav>
        <% } %>
        <% if (typeof user !== "undefined" && user) { %>
          <span class="user"><%= user.email %></span>
        <% } %>
      </header>
      <div class="app-body <%= typeof sideNav !== "undefined" && sideNav && sideNav.length ? "has-side" : "" %>">
        <% if (typeof sideNav !== "undefined" && sideNav && sideNav.length) { %>
          <aside class="app-side">
            <% if (typeof sideTitle !== "undefined" && sideTitle) { %>
              <div class="side-label"><%= sideTitle %></div>
            <% } %>
            <% sideNav.forEach(function (item) { %>
              <a href="<%= item.href %>" class="<%= item.active ? "active" : "" %>"><%= item.label %></a>
            <% }) %>
          </aside>
        <% } %>
        <main class="app-main <%= typeof authPage !== "undefined" && authPage ? "auth-wrap" : "" %>">
          <%- body %>
        </main>
      </div>
    </div>
  </body>
</html>
