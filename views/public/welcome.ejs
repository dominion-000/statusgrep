<section class="hero">
  <div class="hero-mark" aria-hidden="true">
    <img src="/assets/mark.svg" alt="" width="88" height="88" />
  </div>
  <h1 class="hero-title">Status<span>Grep</span></h1>
  <p class="hero-lead">Monitor HTTP endpoints. Track incidents. Publish status.</p>
  <div class="hero-actions">
    <% if (typeof loggedIn !== "undefined" && loggedIn) { %>
      <a class="btn" href="/projects">Go to dashboard</a>
      <a class="btn secondary" href="/logout">Sign out</a>
    <% } else { %>
      <a class="btn" href="/login">Log in</a>
      <a class="btn secondary" href="/register">Sign up</a>
    <% } %>
  </div>
</section>
